# Local Docker Postgres. A hosted demo injects DATABASE_URL at runtime; do not commit that value.
DATABASE_URL=postgresql://notional:notional@localhost:5433/notional
# REDIS_URL is unused by the application. Redis is not required at runtime.
PORT=3000
BETTER_AUTH_SECRET=replace-with-a-32-character-or-longer-secret
BETTER_AUTH_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:5173
# Vite web app: copy apps/web/.env.example to apps/web/.env
# VITE_API_BASE_URL=http://localhost:3000
FAUCET_AMOUNT=100
BINANCE_FAPI_REST_BASE_URL=https://fapi.binance.com
BINANCE_FAPI_MARKET_WS_BASE_URL=wss://fstream.binance.com/market
BINANCE_FAPI_PUBLIC_WS_BASE_URL=wss://fstream.binance.com/public
BINANCE_HTTP_TIMEOUT_MS=10000
INSTRUMENT_SYNC_INTERVAL_MS=3600000
MARKET_DATA_MARK_STALE_MS=10000
MARKET_DATA_BOOK_STALE_MS=10000
BINANCE_WS_RECONNECT_MAX_MS=30000
LIQUIDATION_SCAN_INTERVAL_MS=1000
FUNDING_SCAN_INTERVAL_MS=5000
WS_MARKET_COALESCE_MS=100
WS_IDLE_TIMEOUT_MS=45000
LOG_LEVEL=debug
# TRUST_PROXY accepts only false or true. Unset defaults to false. Numeric values are rejected.
# The Northflank demo keeps false until a separate reviewed client-IP design.
TRUST_PROXY=false
DATABASE_POOL_MAX=10
SHUTDOWN_TIMEOUT_MS=15000
ENABLE_HSTS=false
TEST_DATABASE_URL=postgresql://notional:notional@localhost:5433/notional_test
